DATABASE_URL="postgresql://lp_app:change_in_production@localhost:5432/lp_platform?schema=public"
REDIS_URL="redis://:change_in_production@localhost:6379"
REDIS_PASSWORD="change_in_production"

# JWT - These MUST be set in production; will error out if missing
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

PORT=3001
NODE_ENV=development

# CORS - comma-separated allowed origins
CORS_ORIGINS="http://localhost:3000,https://primeliquidfx.com,https://www.primeliquidfx.com"

# Frontend URL for password reset links
FRONTEND_URL="http://localhost:3000"

# Execution account credential encryption key
# ENCRYPTION_KEY=

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Resend Email Configuration
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

